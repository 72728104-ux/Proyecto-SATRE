# SATRE Analytics · plantilla de entorno (copiar a .env; nunca commitear secretos).
# Generar X_INTERNAL_KEY / INTERNAL_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Puerto del servicio FastAPI (loopback / red interna).
PORT=8001

# Clave compartida con Laravel (header X-Internal-Key). Mínimo 32 caracteres.
# INTERNAL_KEY es el alias legado; ambos deben coincidir si se definen.
X_INTERNAL_KEY=dev-internal-key-satre-analytics-do-not-use-in-prod
INTERNAL_KEY=dev-internal-key-satre-analytics-do-not-use-in-prod

# Usuario MySQL de SOLO LECTURA (GRANT SELECT). Nunca root ni satre_app.
# DB_CONNECTION=sqlite usa SQLite directo. Si queda en mysql y el servidor no
# responde, el motor pasa solo a SQLITE_URL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=satre
DB_USERNAME=satre_ro
DB_PASSWORD=satre_ro_password_example

# Respaldo local cuando MySQL está apagado. Si se omite, se usa data/analytics.db.
SQLITE_URL=sqlite:///./data/analytics.db

# Límite de tamaño del body en bytes
MAX_BODY_BYTES=65536

# API de IA externa (Google Gemini; solo tras PrivacyGuardService).
# Este .env es propio de satre-analytics: no hereda el de satre-backend.
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-3.8-flash
AI_TIMEOUT_SECONDS=20
